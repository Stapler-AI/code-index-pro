{
  "name": "stapler-code-index",
  "version": "1.0.0",
  "description": "Code indexing tools for AI agents",
  "bin": {
    "code-index": "dist/cli.js"
  },
  "files": [
    "dist",
    "queries",
    "integrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "pretest": "npm run build && npm run boundaries",
    "boundaries": "depcruise src benchmarks --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx benchmarks/harness/run.ts",
    "bench:generate": "tsx benchmarks/generate-tasks.ts",
    "bench:judge:selftest": "tsx benchmarks/judge/judge.ts --selftest"
  },
  "author": "Obediah Klopfenstein",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "12.11.1",
    "tree-sitter": "0.25.1",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-typescript": "0.23.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "20.19.43",
    "dependency-cruiser": "^17.4.3",
    "tsx": "^4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
